# ==============================================================================
# Jungle Gaming - Ambiente da aplicação no host
# ==============================================================================
# Modelo de .env para uma aplicação fora dos containers, com credenciais locais.
# compose.services.yaml fornece PostgreSQL e LocalStack.
# O Compose completo tem configurações próprias e não depende deste arquivo.

# ==============================================================================
# Obrigatórias na inicialização - Sem valores padrão no código
# ==============================================================================
DATABASE_URL=postgresql://jungle_main:main_local@127.0.0.1:5432/jungle # Banco acessível pelo host.
SQS_ENDPOINT=http://127.0.0.1:4566    # Exigida mesmo com os workers desativados.
AWS_REGION=us-east-1                # Região do SQS.
AWS_ACCESS_KEY_ID=test              # Credenciais locais do LocalStack.
AWS_SECRET_ACCESS_KEY=test          # Credenciais locais do LocalStack.

# ==============================================================================
# Ativação dos workers - Opcionais na inicialização
# ==============================================================================
# O código desativa os workers por padrão; os valores abaixo ativam o fluxo completo.
COMMAND_CONSUMER_ENABLED=true       # Consumo de comandos SQS.
REFERENCE_WORKER_ENABLED=true       # Resolução de referências pendentes.
OUTBOX_PUBLISHER_ENABLED=true       # Publicação de eventos confirmados.
# Sem o publisher, os eventos permanecem na outbox.

# ==============================================================================
# Opcionais - Configuração do processo no host
# ==============================================================================
DB_INSTANCE_COUNT=1                 # Um processo no host; padrão do código: 3.
# LEDGER_CURSOR_SECRET=local-only-ledger-cursor-secret-32 # Segredo local padrão, público.
# As réplicas compartilham o segredo dos cursores. A troca invalida cursores antigos.
# HOST=0.0.0.0                      # Endereço de escuta HTTP padrão.
# PORT=3000                         # Porta HTTP padrão.
# A aplicação e o Nginx disputam a porta 3000 quando executados no mesmo host.
# Pool, filas, prazos e novas tentativas usam os padrões do código.
# Os limites estão no README.md; as definições, em src/core/config e src/core/database.
# Variável ausente usa o padrão. Valor vazio não equivale a variável ausente.
# A inicialização valida todas as configurações, mesmo com workers desativados.
