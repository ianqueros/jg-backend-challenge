# Os testes compartilham as definições dos serviços, com portas e estado separados.
COMPOSE_FILE=compose.services.yaml:compose.apps.yaml
COMPOSE_PROJECT_NAME=jungle-wagering-test
JUNGLE_DATABASE=jungle_test
JUNGLE_POSTGRES_PORT=55432
JUNGLE_SQS_PORT=4567
JUNGLE_HTTP_PORT=3100
JUNGLE_APP_1_PORT=3101
JUNGLE_APP_2_PORT=3102
JUNGLE_APP_3_PORT=3103
LEDGER_CURSOR_SECRET=integration-only-ledger-cursor-secret

# Estes limites acomodam o cenário de 50 requisições em uma máquina compartilhada.
DB_LOCK_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=2000
